# Adaptateur de base de données : "sqlite" (défaut) | "postgresql" | "json"
DB_PROVIDER="sqlite"

# URL de connexion (SQLite par défaut, ou PostgreSQL si DB_PROVIDER="postgresql")
DATABASE_URL="file:./dev.db"

# Clé secrète pour chiffrer les sessions (générer avec: openssl rand -base64 32)
AUTH_SECRET="your-secure-random-auth-secret-here"

# Faire confiance au reverse proxy / host en production (Docker, Vercel, Railway, etc.)
AUTH_TRUST_HOST="true"
